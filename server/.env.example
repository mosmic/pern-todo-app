# PostgreSQL connection — matches docker-compose.yml defaults
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_db
DB_USER=todo_user
DB_PASSWORD=todo_password

# Express
PORT=3000

# JWT — replace with a long random string before deploying
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_string
